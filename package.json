{
  "name": "@aaarianme/ui",
  "version": "1.1.0",
  "description": "The aaarian.me suite's shared UI kit: Apple-inspired React components, the Tailwind preset and the kit's CSS.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaarianme/aaarian-ui.git"
  },
  "files": [
    "dist",
    "kit.css",
    "tailwind.preset.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.js"
    },
    "./time-zone": {
      "types": "./dist/time-zone.d.ts",
      "import": "./dist/time-zone.js"
    },
    "./tailwind": "./tailwind.preset.js",
    "./kit.css": "./kit.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.1"
  },
  "peerDependencies": {
    "@daypicker/react": ">=10.0.0",
    "date-fns": ">=4.1.0",
    "lucide-react": ">=0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^3.4.17"
  },
  "peerDependenciesMeta": {
    "@daypicker/react": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@daypicker/react": "10.0.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "date-fns": "4.1.0",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "tailwindcss": "3.4.17",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "vitest": "4.1.9"
  }
}
